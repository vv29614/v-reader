{
  "name": "v-editor",
  "version": "1.1.0",
  "description": "本地优先的多格式文档阅读器：PDF/EPUB/DOCX/Markdown/代码/漫画，可拖拽笔记卡片与分屏双开，可选 AI 阅读辅助。不上传、无账号、无遥测。",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "keywords": [
    "reader",
    "pdf",
    "epub",
    "electron",
    "markdown",
    "document"
  ],
  "author": "vv29614",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {},
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1",
    "@highlightjs/cdn-assets": "^11.10.0",
    "dompurify": "^3.1.6",
    "highlight.js": "^11.10.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "marked": "^12.0.2",
    "pdfjs-dist": "^4.10.38"
  },
  "productName": "V编辑器",
  "homepage": "https://github.com/vv29614/v-editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/vv29614/v-editor.git"
  },
  "build": {
    "appId": "com.veditor.app",
    "productName": "V编辑器",
    "copyright": "Copyright © 2026 V Editor",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "package.json",
      "public/**/*",
      "welcome/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "VEditor-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "V 编辑器",
      "uninstallDisplayName": "V 编辑器",
      "deleteAppDataOnUninstall": false
    },
    "afterPack": "scripts/afterPack.js"
  }
}
